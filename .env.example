# Application
NODE_ENV=development
PORT=3000
APP_NAME=matrice-esn-backend
APP_VERSION=1.0.0
APP_DESCRIPTION=Matrice ESN Backend API
API_PREFIX=api
GLOBAL_PREFIX=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=matrice_esn
DB_SSL=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# JWT
JWT_SECRET=your-super-secure-secret-key-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=matrice-esn-backend
JWT_AUDIENCE=matrice-esn-frontend

# Redis (Optional - for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@matrice-esn.com

# File Storage (Optional)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
AWS_S3_BUCKET_NAME=matrice-esn-files
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
ENCRYPTION_KEY=your-32-character-encryption-key

# Monitoring (Optional)
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn
PROMETHEUS_ENABLED=true

# Timezone
TZ=UTC